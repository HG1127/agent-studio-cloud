# Neon Postgres（直连，跑迁移用）
DATABASE_URL=postgresql://<用户>:<密码>@<ep-id>.<区域>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon Postgres（池化，运行时用）
DATABASE_URL_POOLED=postgresql://<用户>:<密码>@<ep-id>-pooler.<区域>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 发布默认模式：设为 1 时默认发布演示版本；显式选择模型连接及已发布版本不受此开关影响
MODEL_MOCK=1
# 环境默认模型（OpenAI 兼容接口；不使用已保存连接发布真实版本时必须提供 MODEL_ID）
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# 模型连接加密主钥：64 位十六进制；不配置时无法保存或解密连接密钥
MODEL_ENCRYPTION_KEY=
# 生产真实模型默认关闭；完成站点访问保护后才设为 1
REAL_MODELS_ENABLED=
# 设为 0 关闭模型意图编译；未关闭时优先默认连接，再用服务端模型，失败回退规则编译
LLM_COMPILE=

# 业务工具注册表（服务端专用 JSON；地址和请求头不会发送到浏览器）
# TOOL_REGISTRY_JSON=[{"id":"crm.update","name":"客户系统","description":"更新客户跟进状态","endpoint":"https://tools.example.com/customer/update","method":"POST","headers":{"Authorization":"Bearer <密钥>"},"action":"update_customer","scope":"customer.write","risk":"medium","inputSchema":{"type":"object"},"outputSchema":{"type":"object","required":["receiptId"],"properties":{"receiptId":{"type":"string"}}}}]
TOOL_REGISTRY_JSON=

# 知识库文件存储（Vercel Blob；不配置时上传仅解析入库、不存原文件）
BLOB_READ_WRITE_TOKEN=

# 定时任务触发接口的访问密钥（/api/schedules/tick 的 Bearer Token，自定随机值）
CRON_SECRET=
